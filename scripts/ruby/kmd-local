#!/usr/bin/env ruby
# frozen_string_literal: true

require 'open3'
require 'pry'
require 'highline'
require 'colored'

# Expansions for rack names.
#
# The keys are used to match against user args, the values are what the match
# is expanded to.
#
# Usually the key and value can be the same, because regex is used to match.
# But if there is a name conflict that causes > 1 match on part of the name
# (eg. 'auth' would match both 'wb-auth-service' and
# 'wb-admin-auth-service'), you can add an extra shorthand entry (eg. 'auth'
# -> 'wb-auth-service').
RACKS = {
  'local' => 'local/convox',
  'staging' => 'waybetter/stagingv3'
}.freeze

# expansions for apps. See comment on RACKS.
APPS = {
  'kraken' => 'kraken',
  'ktest' => 'kraken-test',
  'wb-auth-service' => 'wb-auth-service',
  'auth' => 'wb-auth-service',
  'admin-auth-service' => 'wb-admin-auth-service',
  'wb-admin-web' => 'wb-admin-web',
  'ninja' => 'wb-admin-web',
  'wb-billing-service' => 'wb-billing-service',
  'wb-graphql-service' => 'wb-graphql-service',
  'wb-hub' => 'wb-hub',
  'wb-membership-service' => 'wb-membership-service',
  'wb-metric-service' => 'wb-metric-service',
  'wb-notify-service' => 'wb-notify-service',
  'wb-social-service' => 'wb-social-service',
  'wb-user-service' => 'wb-user-service',
  'wb-asset-service' => 'wb-asset-service',
  'falkor-game-service' => 'falkor-game-service',
}.freeze

# Commands that expand to match any of these regexes will be confirmed by
# user before performing them (unless the no-confirm flag was passed)
CONFIRMS = [
  /convox env set/,
  /convox deploy/,
  /convox restart/,
  /convox apps cancel/,
  /convox apps create/,
  /convox releases promote/,
  /convox scale.*--count/,
  /convox scale.*--memory/,
  /convox run/
].freeze

KMDS = {
  'apps' => { expanded: 'convox apps', args: [:rack] },
  'services' => { expanded: 'convox services', args: %i[rack app] },
  'refresh-env' => { expanded: 'cat ${env_file} | convox env set', args: %i[rack app convox_env_file] },
  'refresh-yml' => { expanded: 'cp -fv ${yml_file} convox.local.yml && convox ps', args: %i[rack app convox_yml_file] },
  'cancel' => { expanded: 'convox apps cancel', args: %i[rack app] },
  'resources' => { expanded: 'convox resources', args: [:rack] },
  'info' => { expanded: 'convox apps info', args: %i[rack app] },
  'start' => { expanded: 'DEBUG_CONVOX=true convox start -m ${config_file}', args: %i[rack app convox_config_file] },
  'restart' => { expanded: 'convox restart', args: %i[rack app] },
  'env' => { expanded: 'convox env', args: %i[rack app] },
  # "promote" =>       { expanded: "convox releases promote", args: %i[rack app wait] },
  'builds' => { expanded: 'convox builds', args: %i[rack app] },
  'releases' => { expanded: 'convox releases', args: %i[rack app] },
  'logs' => { expanded: 'convox logs', args: %i[rack app] },
  'ps' => { expanded: 'convox ps', args: %i[rack app] },
  'deploy' => { expanded: 'convox deploy', args: %i[rack app] },
  'scale' => { expanded: 'convox scale', args: %i[rack app] },
  'konnect' => { expanded: 'konnect-local', args: %i[rack app service_from_ps] },
  'watch-release' => { expanded: 'watch-release', args: %i[rack app] },
  'kwake' => { expanded: 'kwake', args: [] },
  'pt' => { expanded: 'papertrail -f -j --min-time="1 minutes ago"', args: %i[pt_group pt_query pt_klog] },
  'ptdump' => { expanded: 'papertrail -j', args: %i[pt_group pt_time pt_app pt_dump_file] },
  'one-off' => { expanded: 'convox run ${service} "/usr/bin/env bash"', args: %i[rack app release service_from_ps] },
  'rubocop' => { expanded: 'krubocop', args: %i[rack app service_from_ps] }
}.freeze

# Read-only commands that take 'all' as the app, to run them for every app on
# the rack (eg. 'kmd releases -- stag all').
ALL_APPS_KMDS = %w[releases builds ps].freeze

# Columns of the 'convox releases' table, as 'releases pending' reads them.
RELEASE_COLUMNS = %w[ID STATUS BUILD CREATED DESCRIPTION].freeze

# The only rack 'promote pending' may promote on.
PROMOTE_PENDING_RACK = 'waybetter/stagingv3'

# Where each app's git clone lives, to look for migrations in pending releases.
APP_REPOS_DIR = "#{Dir.home}/Work/wb-services"

# Rails migrations. Sequelize apps name their folder in .sequelizerc.
RAILS_MIGRATIONS_DIR = 'db/migrate'

# What 'migrate status' runs in each app's web service ('convox run web'),
# by the kind of migrations its local clone has. Both read the database's
# migrations table and print one 'up'/'down' line per migration. Sequelize
# runs in the NODE_ENV the rack gives the app; Rails needs RAILS_ENV
# (RAILS_ENVS), which a one-off process doesn't get.
MIGRATE_STATUS_COMMANDS = {
  rails: 'bundle exec rails db:migrate:status',
  sequelize: './node_modules/.bin/sequelize db:migrate:status'
}.freeze

# A migration's line in either command's output:
#   Rails:     '   up     20261026120000  Add waiting to supercharger host members'
#   Sequelize: 'up 20261025120000-account-merge.js'
MIGRATION_STATUS_LINE = /\A\s*(up|down)\s+(\d\S*)(.*)\z/.freeze

# Racks whose commands are shown in bold red before confirming.
PRODUCTION_RACKS = %w[waybetter/production waybetter/productionv3 waybetter/prd-west].freeze

# The RAILS_ENV 'migrate status' gives Rails apps on each rack; none on a
# rack that isn't listed (eg. local).
RAILS_ENVS = {
  'waybetter/stagingv3' => 'staging',
  **PRODUCTION_RACKS.to_h { |production_rack| [production_rack, 'production'] }
}.freeze

PAPERTRAIL_GROUPS = {
  'staging' => 'staging-west',
  'production' => 'prod-west'
}.freeze

require "#{File.expand_path(__dir__)}/includes/op_base.rb"

# CLI script which will start tmux
class Kmd < OpBase
  def initialize(confirm: true)
    @production = false
    @confirm = confirm
    cmd_and_args = ARGV.join(' ').split(' -- ')

    return if cmd_and_args.empty?

    if cmd_and_args.size.eql?(1)
      self.command = cmd_and_args.first
    else
      self.command = cmd_and_args[0..-2].map(&:strip).join(' -- ')
      args = cmd_and_args.last.split
      return if args.empty?

      self.rack_filter = args.first
      self.app_filter = args[1] if args.size > 1
      self.service_filter = args[2] if args.size > 2
      self.additional_arg = args[3] if args.size > 3
    end
  end

  def go(command:, args:)
    return go_promote_pending if promote_pending?
    return go_migrate_status if migrate_status?

    command_info, command_args = choose_command
    return go_pending_releases if pending_releases?(command_info, command_args)
    return go_all_apps(command_info, command_args) if all_apps?(command_info)

    expanded_command = [command_info[:expanded]]
    expanded_command << command_args.join(' ') unless command_args.nil?

    command_info[:args].each do |arg|
      send("add_#{arg}", expanded_command)
    end

    expanded_command = expanded_command.join(' ').gsub(/\s+/, ' ')

    if ok_to_launch?(expanded_command)
      exec expanded_command
    else
      puts 'Cancelled'
    end
  end

  def show_help
    puts HELP
  end

  def all_apps?(command_info)
    app_filter.eql?('all') && ALL_APPS_KMDS.include?(KMDS.key(command_info))
  end

  def go_all_apps(command_info, command_args)
    expanded_command = [command_info[:expanded], *command_args]
    add_rack(expanded_command)
    base_command = expanded_command.join(' ').gsub(/\s+/, ' ')

    rack_apps.each do |app|
      app_command = "#{base_command} --app #{app}"
      puts
      system(app_command) if ok_to_launch?(app_command)
    end
  end

  # The rack's apps that are in APPS, skipping dead apps still on the rack.
  def rack_apps
    `convox apps --rack #{rack}`.lines[1..].to_a.filter_map { |l| l.split.first } & APPS.values
  end

  def pending_releases?(command_info, command_args)
    KMDS.key(command_info).eql?('releases') && command_args.eql?(%w[pending])
  end

  # A table of each app's active release, its newest release, and how many
  # releases newer than the active one are waiting to be promoted.
  def go_pending_releases
    add_rack([])
    apps = app_filter.eql?('all') ? rack_apps : [choose_app]
    rows = apps.map { |app| Thread.new { pending_release_row(app) } }.map(&:value)
                .sort_by { |row| [-row[:pending].to_i, row[:app]] }

    print_pending_releases(rows)
  end

  def pending_release_row(app)
    releases = parse_releases(`convox releases --rack #{rack} --app #{app}`)
    active_index = releases.index { |r| r['STATUS'].eql?('active') }

    {
      app: app,
      newest_id: releases.first&.[]('ID'),
      pending: active_index.nil? ? "#{releases.size}+" : active_index.to_s,
      active: release_summary(releases[active_index.to_i]) || '?',
      last_pending: (release_summary(releases.first) unless active_index&.zero?),
      migrations: (pending_migrations(app, releases[active_index], releases.first) if active_index&.positive?)
    }
  end

  # The migrations added between the active release's commit and the newest
  # release's commit, from the app's local clone. A string when it can't tell.
  def pending_migrations(app, active, newest)
    repo = "#{APP_REPOS_DIR}/#{app}"
    return "no local clone at #{repo}" unless File.directory?("#{repo}/.git")

    shas = [active, newest].map { |release| release_sha(release) }
    return "can't read a commit from the release descriptions" unless shas.all?

    dirs = migration_dirs(repo)
    return [] if dirs.empty?

    # Fetch only when a commit isn't in the clone yet.
    system('git', '-C', repo, 'fetch', '-q', 'origin', out: File::NULL, err: File::NULL) unless shas.all? { |sha| git_commit?(repo, sha) }
    return "commit #{shas.reject { |sha| git_commit?(repo, sha) }.join(', ')} not found in #{repo}" unless shas.all? { |sha| git_commit?(repo, sha) }

    IO.popen(['git', '-C', repo, 'diff', '--name-only', '--diff-filter=A', *shas, '--', *dirs], &:read).lines.map(&:strip).sort
  end

  # Release descriptions start with the short commit, eg. '03ddc3548-develop-fix ...'.
  def release_sha(release)
    release['DESCRIPTION'][/\A\h{7,40}(?=-)/]
  end

  def git_commit?(repo, sha)
    system('git', '-C', repo, 'cat-file', '-e', "#{sha}^{commit}", out: File::NULL, err: File::NULL)
  end

  def migration_dirs(repo)
    dirs = [RAILS_MIGRATIONS_DIR].select { |dir| File.directory?("#{repo}/#{dir}") }
    sequelizerc = "#{repo}/.sequelizerc"
    return dirs unless File.file?(sequelizerc)

    sequelize_dir = File.read(sequelizerc)[/["']?migrations-?[Pp]ath["']?\s*:\s*["']([^"']+)["']/, 1]
    dirs + [sequelize_dir&.delete_prefix('./') || 'migrations']
  end

  # 'convox releases' leaves STATUS blank on most rows and CREATED has spaces
  # ("1 hour ago"), so split rows on the header's column positions.
  def parse_releases(output)
    header, *lines = output.lines.map(&:chomp)
    starts = RELEASE_COLUMNS.map { |column| header.to_s.index(column) }
    return [] unless starts.all?

    lines.map do |line|
      RELEASE_COLUMNS.each_with_index.to_h do |column, i|
        [column, line[starts[i]...starts[i + 1]].to_s.strip]
      end
    end
  end

  def release_summary(release)
    return if release.nil?

    "#{release['ID']} #{release['DESCRIPTION'][0, 60]} (#{release['CREATED']})"
  end

  # One line per app: its newest release waiting to be promoted, or its active
  # release when nothing is waiting.
  def print_pending_releases(rows)
    app_width = rows.map { |row| row[:app].size }.max.to_i
    pending_width = 'PENDING'.size

    # The emojis are two columns wide, so the header is indented by three.
    puts "   #{'APP'.ljust(app_width)}  #{'PENDING'.ljust(pending_width)}  RELEASE".bold
    rows.each do |row|
      app_columns = "#{row[:app].ljust(app_width)}  #{row[:pending].ljust(pending_width)}"
      next puts("✅ #{app_columns}  active   #{row[:active]}") if row[:pending].eql?('0')

      puts "⏳ #{app_columns}  pending  #{row[:last_pending]}".yellow
      print_migrations(row[:migrations])
    end
  end

  def print_migrations(migrations)
    return puts("     ⚠️  migrations: #{migrations}".red) if migrations.is_a?(String)

    migrations.to_a.each { |migration| puts "     🛠  migration #{migration}".red }
  end

  # 'promote' isn't in KMDS, so 'promote pending' is matched on the raw command.
  def promote_pending?
    command.to_s.split.eql?(%w[promote pending])
  end

  # Prints the 'releases pending' table, then promotes every app's newest
  # release after one confirmation. Staging only.
  def go_promote_pending
    add_rack([])
    exit_with_error "promote pending only works on staging, not #{rack}" unless rack.eql?(PROMOTE_PENDING_RACK)

    apps = app_filter.eql?('all') ? rack_apps : [choose_app]
    rows = apps.map { |app| Thread.new { pending_release_row(app) } }.map(&:value)
                .sort_by { |row| [-row[:pending].to_i, row[:app]] }
    print_pending_releases(rows)

    # A '5+' count means no active release was found, so it isn't promoted.
    pending = rows.select { |row| row[:pending].match?(/\A\d+\z/) && row[:pending].to_i.positive? }
    skipped = rows.select { |row| row[:pending].end_with?('+') }
    puts "\nSkipping #{skipped.map { |row| row[:app] }.join(', ')}: no active release found".red if skipped.any?

    # Releases with migrations, or whose migrations couldn't be checked, are
    # left for a manual promote and migrate.
    blocked, to_promote = pending.partition { |row| !row[:migrations].is_a?(Array) || row[:migrations].any? }
    print_blocked_promotes(blocked)
    return puts("\nNothing to promote on #{rack}".green) if to_promote.empty?

    commands = to_promote.map { |row| "convox releases promote #{row[:newest_id]} --rack #{rack} --app #{row[:app]}" }
    puts
    commands.each { |cmd| puts cmd.green }
    if confirm && !(cli.ask("Promote #{to_promote.size} app(s) on #{rack}? (enter 'y' to execute)") =~ /^y/)
      return puts('Cancelled')
    end

    failed = commands.reject do |cmd|
      puts "\n#{cmd.yellow}"
      system(cmd)
    end
    puts(failed.empty? ? "\nPromoted #{commands.size} app(s)".green : "\nFailed:\n#{failed.join("\n")}".red)
  end

  def print_blocked_promotes(blocked)
    return if blocked.empty?

    puts "\nNot promoting, migrations pending:".bold.red
    blocked.each do |row|
      puts "  #{row[:app]}".red
      print_migrations(row[:migrations])
    end
  end

  # 'migrate' isn't in KMDS, so 'migrate status' is matched on the raw command.
  def migrate_status?
    command.to_s.split.eql?(%w[migrate status])
  end

  # Runs each app's migration status command in its web service (one
  # 'convox run' per app, in parallel, after one confirmation) and shows
  # whether its latest migration is up. Read only: it never migrates.
  def go_migrate_status
    add_rack([])
    apps = app_filter.eql?('all') ? rack_apps : [choose_app]
    kinds = apps.to_h { |app| [app, migrations_kind(app)] }
    checks = kinds.select { |_app, kind| kind.is_a?(Symbol) }
    skipped = kinds.reject { |_app, kind| kind.is_a?(Symbol) }
    return print_migrate_status(skipped_migrate_rows(skipped)) if checks.empty?

    commands = checks.to_h { |app, kind| [app, migrate_status_command(app, kind)] }
    puts
    commands.each_value { |cmd| puts(production? ? cmd.bold.red : cmd.green) }
    question = "Read the migration status of #{commands.size} app(s) on #{rack}? (enter 'y' to execute)"
    return puts('Cancelled') if confirm && cli.ask(question) !~ /^y/

    puts "\nRunning #{commands.size} one-off process(es), this takes a minute...".yellow
    rows = commands.map { |app, cmd| Thread.new { migrate_status_row(app, cmd) } }.map(&:value)
    print_migrate_status(rows + skipped_migrate_rows(skipped))
  end

  # :rails or :sequelize, from the app's local clone; a string saying why
  # it isn't checked otherwise.
  def migrations_kind(app)
    repo = "#{APP_REPOS_DIR}/#{app}"
    return "no local clone at #{repo}" unless File.directory?(repo)
    return :rails if File.directory?("#{repo}/#{RAILS_MIGRATIONS_DIR}")
    return :sequelize if File.file?("#{repo}/.sequelizerc")

    'no migrations'
  end

  # 'env' sets RAILS_ENV whether or not convox runs the command in a shell.
  def migrate_status_command(app, kind)
    status_command = MIGRATE_STATUS_COMMANDS[kind]
    status_command = "env RAILS_ENV=#{RAILS_ENVS[rack]} #{status_command}" if kind.eql?(:rails) && RAILS_ENVS.key?(rack)
    "convox run web \"#{status_command}\" --rack #{rack} --app #{app}"
  end

  # The app's latest migration (by id, which starts with its timestamp) and
  # how many are down, or what the command printed when no migration line
  # could be read from it.
  def migrate_status_row(app, cmd)
    output, status = Open3.capture2e(cmd, stdin_data: '')
    migrations = output.lines.filter_map do |line|
      match = line.chomp.match(MIGRATION_STATUS_LINE)
      { status: match[1], id: match[2], name: "#{match[2]} #{match[3].strip}".strip } if match
    end
    if migrations.empty?
      last_lines = output.lines.map(&:strip).reject(&:empty?).last(3).join(' | ')
      return { app: app, state: :error, detail: "no migrations read (exit #{status.exitstatus}): #{last_lines}" }
    end

    latest = migrations.max_by { |migration| migration[:id] }
    down = migrations.count { |migration| migration[:status].eql?('down') }
    { app: app, state: latest[:status].eql?('up') ? :up : :down, latest: latest[:name], down: down }
  end

  def skipped_migrate_rows(skipped)
    skipped.map { |app, reason| { app: app, state: :skipped, detail: reason } }
  end

  # One line per app, problems first: its latest migration and whether it's
  # up, how many migrations are down, or why it wasn't read.
  def print_migrate_status(rows)
    order = %i[down error up skipped]
    rows = rows.sort_by { |row| [order.index(row[:state]), row[:app]] }
    app_width = rows.map { |row| row[:app].size }.max.to_i

    # The emojis are two columns wide, so the header is indented by three.
    puts "\n   #{'APP'.ljust(app_width)}  LATEST MIGRATION".bold
    rows.each { |row| puts migrate_status_line(row, app_width) }
  end

  def migrate_status_line(row, app_width)
    app = row[:app].ljust(app_width)
    down = " (#{row[:down]} down)" if row[:down].to_i.positive?
    case row[:state]
    when :up then "✅ #{app}  up    #{row[:latest]}#{down}".then { |line| down ? line.yellow : line }
    when :down then "❌ #{app}  DOWN  #{row[:latest]}#{down}".red
    when :error then "⚠️  #{app}  #{row[:detail]}".red
    else "·  #{app}  #{row[:detail]}"
    end
  end

  protected

  attr_accessor :command, :rack_filter, :app_filter, :confirm, :service_filter,
                :app, :rack, :additional_arg

  def add_rack(expanded_command)
    if (self.rack = choose_rack).nil?
      exit_with_error 'Could not determine rack'
    else
      expanded_command << "--rack #{rack}"
      @production = PRODUCTION_RACKS.include?(rack)
    end
  end

  def add_app(expanded_command)
    if (self.app = choose_app).nil?
      exit_with_error 'Could not determine app'
    else
      expanded_command << "--app #{app}"
    end
  end

  def add_pt_app(expanded_command)
    if (self.app = choose_app).nil?
      exit_with_error 'Could not determine app'
    else
      expanded_command << "-- '#{app}'"
    end
  end

  def add_pt_dump_file(expanded_command)
    fn = "/tmp/pt_#{app.gsub('-', '_')}.log"
    expanded_command << " | klog -s papertrail > #{fn}"
  end

  def add_wait(expanded_command)
    if service_filter && 'wait' =~ /#{service_filter}/
      expanded_command << '--wait'
    else
      expanded_command
    end
  end

  def add_pt_query(expanded_command)
    query = cli.ask "#{'Paper trail query: '.yellow} (default: blank)"
    expanded_command << "-- '#{query}'" unless query.strip.empty?
  end

  def add_pt_group(expanded_command)
    if (ptgroup = choose_papertrail_group).nil?
      exit_with_error 'Could not determine ptgroup'
    else
      expanded_command << "-g #{ptgroup}"
    end
  end

  def add_pt_time(expanded_command)
    t = cli.ask('How many hours?'.yellow).to_s.strip.to_i
    if t.between?(1, 100)
      expanded_command << "--min-time=\"#{t}\ hours ago\""
    else
      exit_with_error 'Could not determine how many hours'
    end
  end

  def add_service_from_ps(expanded_command)
    if (service = choose_service_from_ps).nil?
      exit_with_error 'Could not determine service'
    elsif expanded_command.include?('konnect')
      expanded_command << "--service #{service}"
    elsif 'one-off'.include?(command)
      expanded_command.map! { |str| str.gsub(/\$\{service\}/, service) }
    else
      expanded_command << service
    end
  end

  def add_convox_config_file(expanded_command)
    if (config_file = find_config_file).nil?
      exit_with_error 'Could not find convox configuration file'
    else
      expanded_command.map! do |str|
        str.gsub(/\$\{config_file\}/, config_file)
      end
    end
  end

  def add_convox_yml_file(expanded_command)
    if (yml_file = find_yml_file).nil?
      exit_with_error 'Could not find convox yml file'
    else
      expanded_command.map! do |str|
        str.gsub(/\$\{yml_file\}/, yml_file)
      end
    end
  end

  def add_convox_env_file(expanded_command)
    if (env_file = find_env_file).nil?
      exit_with_error 'Could not find convox env file'
    else
      expanded_command.map! do |str|
        str.gsub(/\$\{env_file\}/, env_file)
      end
    end
  end

  def add_pt_klog(expanded_command)
    expanded_command << '| klog -s papertrail'
  end

  def add_release(expanded_command)
    if (release = choose_release).nil?
      exit_with_error 'Could not determine release'
    else
      expanded_command << "--release #{release}"
    end
  end

  def find_config_file
    if File.file?('convox.local.yml')
      'convox.local.yml'
    elsif File.file?('convox.yml')
      'convox.yml'
    end
  end

  def exec_command(cmd)
    cmd.gsub("'", "\\\\'")
    `#{cmd}`
  end

  def find_yml_file
    if File.file?("#{Dir.home}/Work/docs/local-settings/convox-yml/#{app}.convox.local.yml")
      "#{Dir.home}/Work/docs/local-settings/convox-yml/#{app}.convox.local.yml"
    elsif File.file?("#{Dir.home}/Work/docs/configs/templates/convox-yml/#{app}.convox.local.yml")
      "#{Dir.home}/Work/docs/configs/templates/convox-yml/#{app}.convox.local.yml"
    elsif File.file?('convox.local.yml')
      'convox.local.yml'
    elsif File.file?('convox.yml')
      'convox.yml'
    end
  end

  def find_env_file
    if File.file?("#{Dir.home}/Work/docs/local-settings/convox-env/generated/#{app}.env.local")
      "#{Dir.home}/Work/docs/local-settings/convox-env/generated/#{app}.env.local"
    elsif File.file?("#{Dir.home}/Work/docs/local-settings/convox-env/#{app}.env.local")
      "#{Dir.home}/Work/docs/local-settings/convox-env/#{app}.env.local"
    elsif File.file?("#{Dir.home}/Work/docs/configs/templates/convox-env/#{app}.env.local")
      "#{Dir.home}/Work/docs/configs/templates/convox-env/#{app}.env.local"
    elsif File.file?('.env.local')
      '.env.local'
    else
      exit_with_error("Could not find env file for #{app}")
    end
  end

  def choose_command
    filter = command&.split&.first
    args = command&.split&.[](1..)
    cmd = KMDS[filter] if filter

    if cmd.nil?
      all_cmds = KMDS.keys.sort
      choices = all_cmds.grep Regexp.new(filter || '.*')
      choices = all_cmds if choices.empty?
      cmd = KMDS[choose(msg: 'Command', field: :command, choices: choices)]
    end

    [cmd, args]
  end

  def choose_rack
    default = `convox switch`.strip
    default = 'local' if default =~ /local/
    default = default.split('/').last if default['/']
    choices = convox_racks.keys.grep Regexp.new(rack_filter || '.*')
    choices = convox_racks.keys if choices.empty?
    rack = choose(msg: "Rack (default: #{default})", field: :command, choices: choices, default: default)
    convox_racks[rack]
  end

  def choose_app
    dir = File.basename Dir.pwd
    default = (dir if APPS.include?(dir))

    return APPS[app_filter] if APPS.key?(app_filter)
    return app_filter if APPS.values.include?(app_filter)

    choices = APPS.keys.grep Regexp.new(app_filter || '.*')
    choices = APPS.keys if choices.empty?

    msg = "App #{"(default: #{dir})" if default}"
    app = choose(msg: msg, field: :command, choices: choices, default: default)
    APPS[app]
  end

  def choose_papertrail_group
    default = 'prod-west'

    return PAPERTRAIL_GROUPS[app_filter] if PAPERTRAIL_GROUPS.key?(app_filter)

    choices = PAPERTRAIL_GROUPS.keys.grep Regexp.new(rack_filter || '.*')
    choices = PAPERTRAIL_GROUPS.keys if choices.empty?

    msg = 'Papertrail Group'
    msg << " (default: #{default})" if default
    app = choose(msg: msg, field: :command, choices: choices, default: default)
    PAPERTRAIL_GROUPS[app]
  end

  def choose_service_from_ps
    return service_filter if service_filter

    ps_info = `convox ps --app #{app} --rack #{rack}`
    processes = ps_info.lines[1..].map { |l| l.split[0..1].reverse.join(' ') }
    process = choose(msg: 'Process', field: :command, choices: processes).split
    if 'one-off'.include?(command)
      process.first
    else
      process.last
    end
  end

  def choose_release
    return additional_arg if additional_arg

    release_info = `convox releases --rack #{rack} --app #{app}`
    releases = release_info.lines[1..9].map(&:strip)
    release = choose(msg: '   Release ID   Status  Build ID     Created', field: :command, choices: releases)
    release.split[0]
  end

  def choose(field:, choices:, msg: 'Which?', default: nil)
    return choices.first if choices.size.eql?(1)

    puts "\n#{msg.yellow}"
    cli.choose do |menu|
      menu.readline = true
      choices.each do |name|
        menu.choice(name) { return name }
      end
      menu.choice('quit') { exit 0 }
      menu.default = default if default
    end
  end

  def ok_to_launch?(command)
    return true unless confirm

    needs_a_confirm = !CONFIRMS.detect { |r| !(command =~ r).nil? }.nil?

    if needs_a_confirm
      msg = production? ? command.bold.red : command.green
      answer = cli.ask "#{msg} (enter 'y' to execute)"
      answer =~ /^y/
    else
      puts command.yellow
      true
    end
  end

  def production?
    @production
  end

  def cli
    @_cli = HighLine.new
  end

  HELP = <<-HELP
      kmd is a util for helping you quickly type out convox and kraken commands. Think of it as a bash alias on steriods.

      kmd will extrapolate the names of your convox or kraken command, along with the rack and app, based on partial values.

      If it cannot figure out the command/rack/app, it will present a menu asking you to choose.

      When menus for rack or app are shown, it tries to be smart about defaults so you can just press enter if it guesses right.

      When menus are used, you can type partial answers to select an item, or use tab auto completion.

      Pass 'no-confirm' to override command-specific confirmation requirements.

      Here are some example kmd commad

         kmd
           # -> menus used to choose command, rack, and app as appropriate

         kmd apps
           # -> 'convox apps' assumed, menus used to choose rack

         kmd apps -- pr
           # -> 'convox apps --rack production' assumed, no menus

         kmd logs -- s kr
           # -> 'convox logs --rack staging --app kraken'

         kmd start -- l notify web
           # -> 'convox start web --rack local --app wb-notify-service

         kmd releases -- stag all
           # => convox releases --rack waybetter/stagingv3 --app <app>, for every app in APPS on the rack
           # 'all' works for: #{ALL_APPS_KMDS.join(', ')}

         kmd releases pending -- stag all
           # => a table of every app's active release vs its newest release, and how many are pending promotion
           # also works for one app, eg. 'kmd releases pending -- stag notify'

         kmd promote pending -- stag all
           # => the 'releases pending' table, then promotes every app's newest release after one 'y'
           # apps whose pending releases add Rails or Sequelize migrations are listed in red and not promoted
           # staging only; also works for one app, eg. 'kmd promote pending -- stag notify'

         kmd migrate status -- stag all
           # => for every app on the rack with Rails or Sequelize migrations (from its local clone in ~/Work/wb-services),
           #    runs 'convox run web "env RAILS_ENV=staging bundle exec rails db:migrate:status"' (RAILS_ENV=production on
           #    production; or 'sequelize db:migrate:status') after one 'y',
           #    and shows whether its latest migration is up, and how many are down
           # read only; also works for one app, eg. 'kmd migrate status -- prod notify'

         kmd apps -- sta
           # => convox apps --rack waybetter/staging

         kmd kon -s web -- s user
           # => konnect -s web --rack staging --app wb-user-service

         kmd deploy -s web -- s user no-confirm
           # => convox deploy --rack staging --app wb-user-service
           # the 'deploy' command normally requires confirmation. Adding the
           # no-confirm arg overrides that.

         kmd promote ABCDEFGHIJ -- stg notify wait
           # => convox releases promote ABCDEFGHIJ --rack stg-west --app wb-notify-service --wait
           # the 'promote' command normally requires confirmation. Adding the
           # no-confirm arg overrides that.
           # the 'wait' argument is optional, and will be skipped if not provided

         kmd one-off -- prd notify web ABCDEFGHIJ
           # => convox run web "/usr/bin/env bash" --rack prd-west --app wb-notify-service --release ABCDEFGHIJ
           # the 'one-off' command normally requires confirmation. Adding the
           # no-confirm arg overrides that.
      Sending the rack and app filters is optional. If they are not provided, or if the filter doesnt match anything (or too many things), a menu will be presented to specify them.

      Supported commands: \n\t#{KMDS.sort_by { |k, v| v[:expanded] + k }.map { |k, v| "#{k} (#{v[:expanded]})" }.join("\n\t")}
  HELP

  def exit_with_error(msg)
    # show_help
    puts msg.red
    exit
  end
end

if ['-h', '--help'].include?(ARGV.first)
  Kmd.new.show_help
else
  no_confirm = ARGV.delete('no-confirm')
  confirm = no_confirm.nil?
  Kmd.new(confirm: confirm).go(command: ARGV[0], args: ARGV[1..])
end
